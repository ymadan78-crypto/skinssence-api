# ============================================================
# Skinssence Backend Environment Configuration (Template)
# Copy this file to .env and provide your actual credentials.
# NEVER commit the actual .env file to version control.
# ============================================================

# Turso Cloud Database
TURSO_DATABASE_URL=libsql://your-turso-database.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Authentication (Production requires a strong, random secret)
JWT_SECRET=replace_with_a_long_random_secret

# CORS Allowed Origins (Optional comma-separated list of allowed browser origins; native mobile does not require CORS)
# ALLOWED_ORIGINS=https://your-admin-dashboard.example.com

