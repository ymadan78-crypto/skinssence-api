# ============================================================
# Skinssence Backend Environment Configuration (Template)
# Copy this file to .env and provide your actual credentials.
# NEVER commit the actual .env file to version control.
# ============================================================

# Turso Cloud Database
TURSO_DATABASE_URL=libsql://your-turso-database.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Authentication (Production requires a strong, random secret)
JWT_SECRET=replace_with_a_long_random_secret

# CORS Allowed Origins (Optional comma-separated list of allowed browser origins; native mobile does not require CORS)
# ALLOWED_ORIGINS=https://your-admin-dashboard.example.com

# ============================================================
# Google Contacts Real-Time Auto-Sync (Choose Option A or Option B)
# ============================================================

# Option A: Service Account (Recommended for Google Workspace, e.g. @skinssence.com)
# Place your downloaded JSON key as backend/google-service-account.json or set path below:
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-service-account.json
# If using Google Workspace domain-wide delegation, specify the clinic email to impersonate:
# GOOGLE_IMPERSONATED_USER_EMAIL=clinic@skinssence.com

# Option B: OAuth 2.0 Client (Recommended for personal @gmail.com accounts)
# GOOGLE_OAUTH_CLIENT_ID=your_client_id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret
# GOOGLE_OAUTH_REFRESH_TOKEN=your_refresh_token


